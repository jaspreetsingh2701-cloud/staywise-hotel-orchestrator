    {
      "name": "Hotel Search - Aggregation and Deduplication",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const hotels = pm.response.json();",
              "pm.test('Returns four aggregated hotels', function () {",
              "     pm.expect(hotels).to.be.an('array').that.has.lengthOf(4);",
              "});",
              "pm.test('Holtin uses the cheapest Supplier B offer', function () {",
              "    const hotel = hotels.find(item => item.name === 'Holtin');",
              "    pm.expect(hotel).to.include({ price: 5340, supplier: 'Supplier B', commissionPct: 20 });",
              "});",
              "pm.test('Radison uses the cheapest Supplier A offer', function () {",
              "    const hotel = hotels.find(item => item.name === 'Radison');",
              "    pm.expect(hotel).to.include({ price: 5900, supplier: 'Supplier A', commissionPct: 13 });",
              "});",
              "pm.test('Single-supplier hotels are retained', function () {",
              "    pm.expect(hotels.some(item => item.name === 'Lemon Tree')).to.eql(true);",
              "    pm.expect(hotels.some(item => item.name === 'Taj Palace')).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city={{city}}",
          "host": [
