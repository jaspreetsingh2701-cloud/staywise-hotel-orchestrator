{
  "name": "staywise-hotel-orchestrator",
  "version": "1.0.0",
  "description": "A backend service that aggregates hotel offers from multiple suppliers, compares prices, and returns the best available offer for each hotel.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "temporal:worker": "tsx src/temporal/worker.ts",
    "temporal:search": "tsx src/temporal/run-hotel-search.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaspreetsingh2701-cloud/staywise-hotel-orchestrator.git"
  },
  "keywords": [],
