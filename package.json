  "bugs": {
    "url": "https://github.com/jaspreetsingh2701-cloud/staywise-hotel-orchestrator/issues"
  },
  "homepage": "https://github.com/jaspreetsingh2701-cloud/staywise-hotel-orchestrator#readme",
  "dependencies": {
    "@temporalio/client": "^1.26.0",
    "@temporalio/worker": "^1.26.0",
    "@temporalio/workflow": "^1.26.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
